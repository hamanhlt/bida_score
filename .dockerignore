# Multi-stage build: stage 1 chạy `flutter build web` nên cần source
# (lib/, web/, assets/, pubspec.*). Exclude build artifacts (regenerate trong
# image), native dirs không dùng cho web, VCS/IDE, và file Docker.

# Build artifacts / caches — sẽ regenerate khi `flutter pub get` + `flutter build`
.dart_tool/
.fvm/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# Native platform dirs — web build không cần
android/
ios/
linux/
macos/
windows/

# Test — không build vào image
test/

# VCS / IDE / công cụ
.git/
.github/
.gitignore
.idea/
.vscode/
.claude/
*.iml
*.ipr
*.iws

# File Docker — không cần copy vào image
Dockerfile
docker-compose.yml
.dockerignore

# Tài liệu
CLAUDE.md
README.md
